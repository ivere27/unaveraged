# Public synthetic calibration release: allow only its enumerated files.
!/synth/
/synth/*
!/synth/README.md
!/synth/manifest.json
!/synth/SHA256SUMS
!/synth/images/
/synth/images/*
!/synth/images/000[01][0-9][0-9].png
!/synth/images/0002[0-4][0-9].png
!/synth/images/00025[0-5].png
!/synth/annotations/
/synth/annotations/*
